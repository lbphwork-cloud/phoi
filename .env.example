# =============================================================================
# PHOI — bien moi truong
#
# Sao chep file nay thanh .env.local roi dien gia tri that:
#     cp .env.example .env.local
#
# .env.local da nam trong .gitignore, khong bao gio bi day len GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# BAT BUOC — lay o Supabase: Project Settings -> API
# -----------------------------------------------------------------------------

# Dia chi project, dang https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Khoa "anon" / "public".
#
# Khoa nay KHONG phai secret va CO THE nam trong ma nguon frontend. No chi noi
# "toi la khach cua project nay"; moi quyen thuc su do Row Level Security quyet
# dinh. Day la ly do phai chay du ca 6 file migration — file 0002_rls.sql moi
# la lop bao ve that.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# =============================================================================
# TUYET DOI KHONG dat SUPABASE_SERVICE_ROLE_KEY vao file nay.
#
# Khoa service role bo qua toan bo RLS. Bat ky ai co no deu doc va sua duoc moi
# du lieu cua moi nguoi dung. No chi duoc xuat hien o hai noi:
#
#   1. local-helper/.env  — tren may ca nhan cua ban, khong bao gio push len
#   2. Bien moi truong cua Edge Function (dat trong bang dieu khien Supabase)
#
# Moi bien co tien to NEXT_PUBLIC_ deu bi nhung thang vao ma JavaScript gui
# tori trinh duyet. Neu dat service role key o day thi coi nhu da cong khai no.
# =============================================================================


# =============================================================================
# TUY CHON — chi can neu ban muon chay migration bang mot lenh thay vi dan tay
#
#   npm run db:apply
#
# Lay o: Supabase -> Project Settings -> Database -> Connection string -> URI
# Chon ban "Session pooler" (cong 5432), KHONG phai "Transaction pooler" (6543).
#
# Chuoi nay chua MAT KHAU DATABASE. No khong co tien to NEXT_PUBLIC_ nen khong
# bao gio bi nhung vao JavaScript gui toi trinh duyet, va website ban da xuat ra
# la trang tinh nen khong co may chu nao doc no. No chi duoc dung boi cac script
# trong thu muc scripts/, chay tren may ban.
#
# Xoa dong nay sau khi chay xong migration cung duoc — website khong can no.
# =============================================================================

# SUPABASE_DB_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
