# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# BIEN MOI TRUONG — quan trong nhat trong file nay
#
# .env* chan MOI file env, ke ca local-helper/.env chua SERVICE ROLE KEY.
# Khoa do bo qua toan bo Row Level Security; ro ri no la mat toan bo du lieu.
#
# Ngoai le duy nhat: cac file .env.example (khong chua gia tri that) duoc commit
# de nguoi moi biet phai dien nhung bien nao.
# =============================================================================
.env*
!.env.example
!**/.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# =============================================================================
# Local Helper (Python, chay tren may ca nhan)
# =============================================================================
local-helper/.venv/
local-helper/__pycache__/
local-helper/*.pyc
# Phien trinh duyet: chua cookie cua chinh ban tren Shopee/TikTok.
# TUYET DOI khong commit — de bai muc 9: "khong dua cookie dang nhap len cloud".
local-helper/.browser-profile/

# Ket qua bien dich cua scripts/verify-*.ts
.verify-out/

# Thu muc tam cua Supabase CLI
supabase/.branches/
supabase/.temp/

# Ban ghi hoi thoai xuat ra tu Claude Code — chua khoa API chua che.
# Ban DA CHE nam trong tai-lieu/ va duoc theo doi binh thuong.
2026-*-this-session-*.txt
