# =============================================================================
# PHOI Local Helper — bien moi truong
#
#   cp .env.example .env
#
# CO HAI CACH XAC THUC. Chon MOT.
# =============================================================================

SUPABASE_URL=https://xxxxxxxx.supabase.co


# -----------------------------------------------------------------------------
# CACH B — DANG NHAP BANG TAI KHOAN QUAN TRI  (khuyen dung cho mot nguoi van hanh)
#
# Khong can khoa bo qua bao mat. Policy fetch_jobs_all_own cho phep
# `requested_by = auth.uid() OR is_admin()`, nen mot tai khoan admin doc va ghi
# duoc MOI job.
#
# Danh doi: JWT het han sau khoang mot gio nen chuong trinh tu dang nhap lai.
# Han che: neu website co NHIEU nguoi dang bai va ban muon Local Helper phuc vu
# ca ho, van dung duoc — vi is_admin() thay het. Chi khong dung duoc neu tai
# khoan chay helper khong phai admin.
# -----------------------------------------------------------------------------

SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_EMAIL=admin@example.com
SUPABASE_PASSWORD=


# -----------------------------------------------------------------------------
# CACH A — KHOA SERVICE ROLE
#
# Supabase -> Project Settings -> API Keys -> Secret key
#
# CANH BAO: khoa nay BO QUA TOAN BO Row Level Security. Ai co no deu doc va sua
# duoc moi du lieu cua moi nguoi dung.
#
#   - KHONG commit file .env (da nam trong .gitignore)
#   - KHONG dat khoa nay vao .env.local cua Next.js
#   - KHONG dat vao bat ky bien nao co tien to NEXT_PUBLIC_
#   - Neu nghi da bi ro ri: Supabase -> API Keys -> thu hoi roi tao khoa moi
# -----------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=
