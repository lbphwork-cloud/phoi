# =============================================================================
# PHOI Local Helper — bien moi truong
#
#   cp .env.example .env
#
# =============================================================================
# CANH BAO
#
# File .env nay chua SERVICE ROLE KEY. Khoa do BO QUA TOAN BO Row Level
# Security: ai co no deu doc va sua duoc moi du lieu cua moi nguoi dung.
#
#   - KHONG commit file .env (da nam trong .gitignore)
#   - KHONG dat khoa nay vao .env.local cua Next.js
#   - KHONG dat vao bat ky bien nao co tien to NEXT_PUBLIC_
#   - Neu nghi da bi ro ri: vao Supabase Project Settings -> API -> Rotate
#
# Local Helper can service role vi no phai doc bang fetch_jobs cua MOI nguoi
# dung, khong chi cua mot phien dang nhap. Day la ly do duy nhat.
# =============================================================================

# Giong NEXT_PUBLIC_SUPABASE_URL, dang https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
